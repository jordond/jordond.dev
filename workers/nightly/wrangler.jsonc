{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jordond-dev-nightly",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  // Cron only, nothing to serve over HTTP
  "workers_dev": false,
  "preview_urls": false,
  // Deploys fail until this is set: wrangler secret put GITHUB_TOKEN
  "secrets": {
    "required": ["GITHUB_TOKEN"],
  },
  "triggers": {
    // Every night at 2:00 AM UTC
    "crons": ["0 2 * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
