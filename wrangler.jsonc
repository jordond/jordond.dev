{
  "name": "jordond-dev",
  "compatibility_date": "2026-02-03",
  // Serves PR previews at pr-<number>-jordond-dev.<subdomain>.workers.dev
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
