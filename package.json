{
  "name": "jordond.dev",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check",
    "test": "bun run test:unit && bun run test:smoke && bun run test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:smoke": "vitest run tests/smoke",
    "test:e2e": "playwright test --project desktop --project mobile",
    "test:visual": "playwright test --project visual-desktop --project visual-mobile",
    "test:visual:update": "playwright test --project visual-desktop --project visual-mobile --update-snapshots",
    "visual:accept": "bash scripts/visual-accept.sh",
    "astro": "astro",
    "fetch-repos": "bun run scripts/fetch-repos.ts",
    "deploy": "astro build && wrangler deploy",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.0.0",
    "husky": "^9.1.7",
    "linkedom": "^0.18.13",
    "lint-staged": "^17.5.1",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.0.1",
    "vitest": "^5.0.1",
    "wrangler": "^4.134.0"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "workerd"
  ],
  "prettier": {
    "semi": false,
    "trailingComma": "all",
    "astroCompressHTML": "html",
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  },
  "lint-staged": {
    "*.{ts,css,md,astro,json,yml}": "prettier --write"
  }
}
