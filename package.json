{
  "name": "jordond.dev",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "astro": "astro",
    "fetch-repos": "bun run scripts/fetch-repos.ts",
    "deploy": "astro build && wrangler deploy",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "3.9.7",
    "prettier-plugin-astro": "1.0.1",
    "wrangler": "^4.134.0"
  },
  "packageManager": "bun@1.3.13",
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "workerd"
  ],
  "prettier": {
    "semi": false,
    "trailingComma": "all",
    "astroCompressHTML": "html",
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  },
  "lint-staged": {
    "*.{ts,css,md,astro}": "prettier --write"
  }
}
