---
import "../styles/global.css"

interface Props {
  title?: string
  description?: string
  image?: string
}

const {
  title = "Jordon de Hoog | Kotlin & KMP Developer",
  description = "Android and Kotlin Multiplatform engineer. Open source libraries shipping inside real products on iOS, Android, desktop, and the JVM. Maintainer of MaterialKolor, connectivity, and compass.",
  image = "https://jordond.dev/og-image.png",
} = Astro.props

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || "https://jordond.dev",
)
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Jordon de Hoog" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <meta name="theme-color" content="#d4572a" />
    <meta name="color-scheme" content="dark light" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Jordon de Hoog" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Petrona:ital,wght@0,400;0,500;0,700;0,800;0,900;1,400;1,500&family=Schibsted+Grotesk:ital,wght@0,400;0,500;0,700;1,400;1,500&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      ;(function () {
        let savedTheme = null
        try {
          savedTheme = localStorage.getItem("theme")
        } catch (_) {
          /* Safari private mode / sandboxed iframes throw on storage access. */
        }
        const systemPrefersDark =
          window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: dark)").matches
        const theme = savedTheme || (systemPrefersDark ? "dark" : "light")
        document.documentElement.setAttribute("data-theme", theme)
      })()
    </script>
    <noscript>
      <style>
        .animate-on-scroll,
        .animate-fade-in-up {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body
    class="min-h-screen bg-[var(--color-bg)] text-[var(--color-text)] antialiased transition-colors duration-300"
  >
    <slot />
  </body>
</html>
