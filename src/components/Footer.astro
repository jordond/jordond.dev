---
import Icon from "./Icon.astro"
import type { IconName } from "../lib/icons"

const currentYear = new Date().getFullYear()

const socialLinks: { name: string; url: string; icon: IconName }[] = [
  { name: "GitHub", url: "https://github.com/jordond", icon: "github" },
  {
    name: "LinkedIn",
    url: "https://linkedin.com/in/jordondehoog",
    icon: "linkedin",
  },
]
---

<footer class="footer">
  <div class="footer__colophon" aria-hidden="true">
    <span>Colophon</span>
    <span class="footer__rule"></span>
    <span>Typeset in Petrona, Schibsted Grotesk &amp; JetBrains Mono</span>
  </div>

  <div class="footer__inner">
    <a href="mailto:jordon@jordond.dev" class="footer__mark">
      <span>Say</span>
      <em>hello</em>
      <span aria-hidden="true">↗</span>
    </a>

    <div class="footer__meta">
      <div class="footer__socials">
        {
          socialLinks.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="me noopener noreferrer"
              aria-label={link.name}
              class="footer__social"
            >
              <Icon name={link.icon} />
            </a>
          ))
        }
        <a
          href="/resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="footer__resume"
        >
          résumé ↗
        </a>
      </div>

      <p class="footer__fine">
        <span>© {currentYear} Jordon de Hoog</span>
        <span class="footer__dot" aria-hidden="true">·</span>
        <span>Built in London, Ontario</span>
        <span class="footer__dot" aria-hidden="true">·</span>
        <a
          href="https://github.com/jordond/jordond.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="footer__src"
        >
          view source
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding: clamp(3rem, 7vw, 5.5rem) var(--gutter) clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-rule);
    margin-top: var(--space-3xl);
  }

  .footer__colophon {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    letter-spacing: var(--tr-mono-caps-lg);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--stack-md);
    max-width: var(--max-content);
    margin-left: auto;
    margin-right: auto;
  }

  .footer__rule {
    flex: 1 1 auto;
    height: 1px;
    background: var(--color-rule);
  }

  .footer__inner {
    max-width: var(--max-content);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, auto);
    gap: var(--stack-md);
    align-items: end;
  }

  @media (max-width: 760px) {
    .footer__inner {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }

  .footer__mark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--fs-display-md);
    line-height: var(--lh-display);
    letter-spacing: var(--tr-display);
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.4s var(--ease-out-expo);
  }

  .footer__mark em {
    font-style: italic;
    font-weight: 500;
    color: var(--color-accent);
  }

  .footer__mark span:last-child {
    font-size: 0.42em;
    align-self: start;
    margin-left: 0.3em;
    color: var(--color-accent);
    transition: transform 0.4s var(--ease-out-expo);
  }

  .footer__mark:hover span:last-child {
    transform: translate(4px, -4px);
  }

  .footer__meta {
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.25rem;
  }

  @media (max-width: 760px) {
    .footer__meta {
      text-align: left;
      align-items: flex-start;
    }
  }

  .footer__socials {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .footer__social {
    color: var(--color-text-muted);
    display: inline-flex;
    /* Expand hit area to 36×36px without shifting layout (WCAG 2.5.8) */
    padding: 0.5rem;
    margin: -0.5rem;
    transition: color 0.3s var(--ease-out-expo);
  }

  .footer__social:hover {
    color: var(--color-accent-ink);
  }

  .footer__social :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .footer__resume {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    letter-spacing: var(--tr-mono-caps);
    text-transform: uppercase;
    color: var(--color-accent-ink);
    text-decoration: none;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--color-accent);
    transition:
      background-color 0.3s var(--ease-out-expo),
      color 0.3s var(--ease-out-expo);
  }

  .footer__resume:hover {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }

  .footer__fine {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    letter-spacing: var(--tr-mono);
    color: var(--color-text-muted);
    margin: 0;
    display: flex;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .footer__dot {
    color: var(--color-rule);
  }

  .footer__src {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule);
    transition:
      color 0.3s var(--ease-out-expo),
      border-color 0.3s var(--ease-out-expo);
  }

  .footer__src:hover {
    color: var(--color-accent-ink);
    border-bottom-color: var(--color-accent);
  }
</style>
