---
import { Image } from "astro:assets"
import avatar from "../assets/avatar.jpg"
import { skills } from "../config/data"
import SectionHeader from "./SectionHeader.astro"
---

<section id="about" class="section about">
  <div class="section__inner">
    <SectionHeader index="§ 01 · about" kicker="The elevator pitch">
      <Fragment slot="title">
        Kotlin,<br />
        <em>mostly</em>.
      </Fragment>
      <Fragment slot="lead">
        Libraries, tools, and production apps. Most of it open source, most of
        it Kotlin. A handful of the libraries now ship inside other people's
        products, on iOS, Android, desktop, and the JVM.
      </Fragment>
    </SectionHeader>

    <div class="about__body">
      <div class="about__copy">
        <p class="about__lead">
          <span class="about__drop">H</span>ello. I'm Jordon. I make the kind of
          developer tools you install once, forget about, and notice the day
          they aren't there. Android libraries, <span class="about__accent"
            >Kotlin Multiplatform</span
          > modules, and the occasional IDE plugin that makes someone's Monday easier.
        </p>

        <p class="about__para">
          Most of my time goes into open source. <span class="about__accent"
            >MaterialKolor</span
          >, <span class="about__accent">compass</span>, <span
            class="about__accent">jolt</span
          >, and a handful of smaller libraries. The apps pay the rent. The
          libraries are where the experiments live.
        </p>

        <div class="about__skills">
          <p class="about__skills-label">Currently working with</p>
          <ul class="about__skills-list">
            {
              skills.map((skill) => (
                <li class="about__skill">
                  <span class="about__skill-mark" aria-hidden="true">
                    ▸
                  </span>
                  {skill}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <figure class="about__figure">
        <div class="about__portrait">
          <span class="about__portrait-backer" aria-hidden="true"></span>
          <Image
            src={avatar}
            alt="Portrait of Jordon de Hoog"
            width={1200}
            height={1200}
            loading="lazy"
            class="about__portrait-img"
          />
        </div>
        <figcaption class="about__caption">
          <span class="about__caption-idx">pl.&nbsp;01</span>
          <span>For reference.</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .about__body {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.9fr);
    gap: var(--stack-lg);
    align-items: start;
  }

  @media (max-width: 900px) {
    .about__body {
      grid-template-columns: 1fr;
      gap: var(--stack-md);
    }
  }

  .about__copy {
    max-width: var(--max-prose);
  }

  .about__lead {
    font-family: var(--font-body);
    font-size: var(--fs-lead-lg);
    line-height: 1.5;
    color: var(--color-text);
    margin: 0 0 var(--space-md);
    font-weight: 400;
    text-wrap: pretty;
  }

  .about__drop {
    float: left;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 4.8em;
    line-height: 0.82;
    padding: 0.08em 0.08em 0 0;
    margin: 0.05em 0.12em 0 -0.04em;
    color: var(--color-accent);
  }

  .about__para {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    line-height: var(--lh-prose);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-lg);
    max-width: 56ch;
  }

  .about__accent {
    color: var(--color-accent-ink);
    font-weight: 500;
  }

  .about__skills {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-rule);
  }

  .about__skills-label {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    letter-spacing: var(--tr-mono-caps-lg);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-sm);
  }

  .about__skills-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2xs) var(--space-md);
  }

  .about__skill {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-md);
    color: var(--color-text);
  }

  .about__skill-mark {
    color: var(--color-accent);
    font-size: var(--fs-mono-sm);
  }

  .about__figure {
    margin: 0;
    position: relative;
    padding: clamp(0.5rem, 2vw, 1.5rem);
  }

  .about__portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    max-width: 22rem;
    margin-left: auto;
    transform: rotate(1.2deg);
  }

  @media (max-width: 900px) {
    .about__portrait {
      margin: 0 auto;
    }
  }

  .about__portrait-backer {
    position: absolute;
    inset: 1.25rem -1.25rem -1.25rem 1.25rem;
    background: var(--color-accent);
    z-index: 0;
    transform: rotate(-2.4deg);
    transition: transform 0.5s var(--ease-out-expo);
  }

  .about__portrait:hover .about__portrait-backer {
    transform: rotate(-3.6deg) translate(-4px, 4px);
  }

  .about__portrait-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 1px solid var(--color-rule);
    transition: transform 0.5s var(--ease-out-expo);
    filter: grayscale(0.12) contrast(1.02);
  }

  .about__portrait:hover .about__portrait-img {
    transform: translate(-4px, -4px);
  }

  .about__caption {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    margin-top: 1.5rem;
    padding-left: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    letter-spacing: var(--tr-mono);
    color: var(--color-text-muted);
    text-transform: lowercase;
  }

  .about__caption-idx {
    color: var(--color-accent-ink);
    font-weight: 500;
  }
</style>
