---
import { Image } from "astro:assets"
import avatar from "../assets/avatar.jpg"
import { skills } from "../config/data"
import { Picture } from "astro:assets"
---

<section id="about" class="py-20 px-6">
  <div class="max-w-4xl mx-auto">
    <h2
      class="flex items-center text-2xl md:text-3xl font-bold text-[var(--color-text)] mb-12 animate-on-scroll"
    >
      <span class="text-accent font-mono text-xl mr-2">01.</span>
      About Me
      <span class="ml-4 h-px flex-1 bg-[var(--color-surface-elevated)]"></span>
    </h2>

    <div class="grid md:grid-cols-3 gap-12 items-start">
      <div class="md:col-span-2 space-y-4 animate-on-scroll delay-100">
        <p class="text-[var(--color-text-muted)] leading-relaxed">
          Hello! I'm Jordon, an Android and Kotlin Multiplatform developer based
          in
          <span class="text-accent">London, Ontario, Canada</span>. I enjoy
          creating tools and libraries that help other developers build better
          applications.
        </p>
        <p class="text-[var(--color-text-muted)] leading-relaxed">
          My current focus is <span class="text-accent"
            >Kotlin Multiplatform</span
          > development, from production apps to the libraries that support them.
          I maintain several open source libraries used by teams shipping to Android,
          iOS, and desktop.
        </p>

        <div class="pt-4">
          <p class="text-[var(--color-text)] font-medium mb-3">
            Technologies I work with:
          </p>
          <ul class="grid grid-cols-2 gap-2">
            {
              skills.map((skill) => (
                <li class="flex items-center text-[var(--color-text-muted)]">
                  <span class="text-accent mr-2">&#9656;</span>
                  {skill}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="animate-on-scroll delay-200">
        <div class="relative group">
          <div
            class="absolute -inset-2 bg-gradient-to-r from-accent to-accent-light rounded-lg opacity-20 blur-lg group-hover:opacity-30 transition-opacity duration-300"
          >
          </div>
          <div class="relative">
            <Image
              src={avatar}
              alt="Avatar of Jordon de Hoog"
              width={1200}
              height={1200}
              loading="lazy"
              class="aspect-square object-cover rounded-lg w-full mx-auto border-4 border-[var(--color-surface-elevated)] transition-transform duration-300 group-hover:scale-[1.02]"
            />
          </div>
        </div>

        <div
          class="mt-4 flex items-center justify-center gap-2 text-sm text-[var(--color-text-muted)]"
        >
          <span class="relative flex h-3 w-3">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"
            ></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"
            ></span>
          </span>
          Available for opportunities
        </div>

        <div class="mt-3 flex justify-center">
          <a
            href="https://github.com/jordond"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-4 py-2 rounded-lg border border-accent text-accent text-sm font-medium hover:bg-accent/10 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-[var(--color-bg)]"
          >
            <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
            GitHub
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
