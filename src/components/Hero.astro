---
import HeroTopbar from "./hero/HeroTopbar.astro"
import HeroLede from "./hero/HeroLede.astro"
import HeroCodeCard from "./hero/HeroCodeCard.astro"
import { buildKotlinCode } from "./hero/kotlinCode"
import reposData from "../data/repos.json"
import type { GroupedRepoData } from "../types/repo"

const { libraries } = reposData as GroupedRepoData
const totalStars = libraries.reduce((sum, l) => sum + l.stargazers_count, 0)
const shipped = ["Should I Go Outside?", "jolt", "compose-resources-kit"]
const codeHtml = buildKotlinCode({ libraries, shipped, totalStars })
---

<section class="hero" aria-labelledby="hero-headline">
  <HeroTopbar />
  <div class="hero__inner">
    <HeroLede />
    <HeroCodeCard codeHtml={codeHtml} />
  </div>
  <div class="hero__footnote" aria-hidden="true">
    <span>scroll</span>
    <span class="hero__footnote-rule"></span>
    <span>work &amp; community below</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    padding: clamp(1.25rem, 2.4vw, 2rem) var(--gutter)
      clamp(1.5rem, 3vw, 2.5rem);
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--stack-md);
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 80% 55% at 12% 8%,
        var(--color-accent-soft) 0%,
        transparent 60%
      ),
      radial-gradient(
        ellipse 60% 40% at 100% 100%,
        var(--color-accent-soft) 0%,
        transparent 55%
      );
    opacity: 0.7;
    z-index: 0;
  }

  .hero::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--gutter);
    width: 1px;
    background: var(--color-rule);
    opacity: 0.35;
    pointer-events: none;
    z-index: 0;
  }

  .hero > * {
    position: relative;
    z-index: 1;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.95fr);
    gap: var(--stack-md);
    align-items: center;
  }

  @media (max-width: 960px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--stack-md);
      align-items: start;
    }
  }

  .hero__footnote {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    letter-spacing: var(--tr-mono-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
    opacity: 0;
    animation: fadeInUp 0.9s 1.4s var(--ease-out-expo) forwards;
  }

  .hero__footnote-rule {
    flex: 1 1 auto;
    height: 1px;
    background: var(--color-rule);
  }

  @media (max-width: 640px) {
    .hero::after {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__footnote {
      opacity: 1;
      animation: none;
    }
  }
</style>

<script is:inline>
  document.documentElement.classList.add("js")
</script>

<script>
  import { initHero } from "./hero/heroMotion"
  initHero()
</script>
