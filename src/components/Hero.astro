---
import ThemeToggle from "./ThemeToggle.astro"
import Icon from "./Icon.astro"
import reposData from "../data/repos.json"
import type { GroupedRepoData } from "../types/repo"

const { libraries } = reposData as GroupedRepoData
const featuredLibraries = libraries.slice(0, 4).map((l) => l.name)
const shippedApps = ["Should I Go Outside?", "jolt"]

const line = (inner: string, blank = false) =>
  `<span class="cl${blank ? " cl--blank" : ""}">${inner || " "}</span>`
const kw = (t: string) => `<span class="tok-kw">${t}</span>`
const ty = (t: string) => `<span class="tok-type">${t}</span>`
const prop = (t: string) => `<span class="tok-prop">${t}</span>`
const str = (t: string) => `<span class="tok-str">"${t}"</span>`
const fn = (t: string) => `<span class="tok-fn">${t}</span>`
const bool = (t: string) => `<span class="tok-bool">${t}</span>`
const pn = (t: string) => `<span class="tok-punct">${t}</span>`
const cmt = (t: string) => `<span class="tok-comment">${t}</span>`

const listBlock = (name: string, items: string[]) =>
  [
    line(`  ${kw("val")} ${prop(name)} ${pn("=")} ${fn("listOf")}${pn("(")}`),
    ...items.map((it) => line(`    ${str(it)}${pn(",")}`)),
    line(`  ${pn(")")}`),
  ].join("")

const codeHtml = [
  line(cmt("// the short version")),
  line(`${kw("data object")} ${ty("Jordon")} ${pn("{")}`),
  line(
    `  ${kw("val")} ${prop("role")} ${pn("=")} ${str("Android / KMP engineer")}`,
  ),
  line(
    `  ${kw("val")} ${prop("based")} ${pn("=")} ${str("London, Ontario, Canada")}`,
  ),
  line(`  ${kw("val")} ${prop("available")} ${pn("=")} ${bool("true")}`),
  line("", true),
  listBlock("shipped", shippedApps),
  line("", true),
  listBlock("libraries", featuredLibraries),
  line(pn("}")),
].join("")
---

<section class="hero" aria-labelledby="hero-headline">
  <div class="hero__topbar">
    <a href="/" class="hero__mark" aria-label="Jordon de Hoog, home">
      jordond<span class="hero__mark-dot" aria-hidden="true">.</span>dev
    </a>
    <ThemeToggle />
  </div>

  <div class="hero__inner">
    <div class="hero__lede">
      <p class="hero__eyebrow">
        <span class="hero__status" aria-hidden="true">
          <span class="hero__status-dot"></span>
        </span>
        <span>Available for hire</span>
        <span class="hero__eyebrow-sep" aria-hidden="true">·</span>
        <span>London, Ontario</span>
      </p>

      <h1 id="hero-headline" class="hero__headline">
        <span class="hero__line"
          >Android apps<span class="hero__period">.</span></span
        >
        <span class="hero__line"
          ><em>Kotlin</em> libraries<span class="hero__period">.</span></span
        >
        <span class="hero__line"
          >Open source, mostly<span class="hero__period">.</span></span
        >
      </h1>

      <p class="hero__byline">
        <span class="hero__name">Jordon de Hoog</span>
        <span class="hero__byline-rule" aria-hidden="true"></span>
        <span class="hero__byline-tags"
          >Android <span aria-hidden="true">·</span> Kotlin Multiplatform <span
            aria-hidden="true">·</span
          > Open&nbsp;Source</span
        >
      </p>

      <div class="hero__actions">
        <a
          class="btn btn--primary"
          href="/resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="document" />
          <span>Résumé</span>
          <Icon name="arrow" class="btn__arrow" />
        </a>
        <a class="btn btn--ghost" href="mailto:jordon@jordond.dev">
          <Icon name="envelope" />
          <span>Email</span>
        </a>
        <a
          class="btn btn--ghost"
          href="https://linkedin.com/in/jordondehoog"
          target="_blank"
          rel="me noopener noreferrer"
          aria-label="LinkedIn profile"
        >
          <Icon name="linkedin" />
          <span>LinkedIn</span>
        </a>
      </div>
    </div>

    <aside class="hero__aside" aria-hidden="true">
      <div class="hero__code">
        <div class="hero__code-chrome">
          <span class="hero__code-dot"></span>
          <span class="hero__code-dot"></span>
          <span class="hero__code-dot"></span>
          <span class="hero__code-file">Jordon.kt</span>
        </div>
        <pre class="hero__code-body"><code set:html={codeHtml} /></pre>
      </div>
      <p class="hero__caption">
        <span class="hero__caption-idx">fig.&nbsp;01</span>
        Hello, in Kotlin.
      </p>
    </aside>
  </div>

  <div class="hero__footnote" aria-hidden="true">
    <span>scroll</span>
    <span class="hero__footnote-rule"></span>
    <span>work &amp; community below</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    padding: clamp(1.25rem, 2.4vw, 2rem) var(--gutter)
      clamp(1.5rem, 3vw, 2.5rem);
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--stack-md);
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 80% 55% at 12% 8%,
        var(--color-accent-soft) 0%,
        transparent 60%
      ),
      radial-gradient(
        ellipse 60% 40% at 100% 100%,
        var(--color-accent-soft) 0%,
        transparent 55%
      );
    opacity: 0.7;
    z-index: 0;
  }

  .hero::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--gutter);
    width: 1px;
    background: var(--color-rule);
    opacity: 0.35;
    pointer-events: none;
    z-index: 0;
  }

  .hero > * {
    position: relative;
    z-index: 1;
  }

  .hero__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-md);
  }

  .hero__mark {
    display: inline-flex;
    align-items: baseline;
    gap: 0;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-rule);
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: 0.08em;
    font-weight: 500;
    transition:
      border-color 0.3s var(--ease-out-expo),
      color 0.3s var(--ease-out-expo);
    opacity: 0;
    animation: fadeInUp 0.9s var(--ease-out-expo) forwards;
  }

  .hero__mark:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .hero__mark-dot {
    color: var(--color-accent);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.95fr);
    gap: var(--stack-md);
    align-items: center;
  }

  @media (max-width: 960px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--stack-md);
      align-items: start;
    }
  }

  .hero__lede {
    max-width: 46ch;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    letter-spacing: var(--tr-mono-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: clamp(1.25rem, 2vw, 1.75rem);
    opacity: 0;
    animation: fadeInUp 0.9s 0.1s var(--ease-out-expo) forwards;
  }

  .hero__eyebrow-sep {
    color: var(--color-rule);
  }

  .hero__status {
    position: relative;
    display: inline-flex;
    width: 0.6rem;
    height: 0.6rem;
  }

  .hero__status-dot {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 0 var(--color-accent-soft);
    animation: heroPulse 2.4s var(--ease-out-expo) infinite;
  }

  @keyframes heroPulse {
    0% {
      box-shadow: 0 0 0 0 var(--color-accent-soft);
    }
    70% {
      box-shadow: 0 0 0 0.55rem transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  .hero__headline {
    font-family: var(--font-display);
    font-weight: 900;
    /* svh cap keeps headline + byline + actions above the fold on short viewports. */
    font-size: min(clamp(2rem, 5.2vw + 0.25rem, 4.75rem), 10.5svh);
    line-height: 0.94;
    letter-spacing: var(--tr-display);
    color: var(--color-text);
    margin: 0 0 clamp(1rem, 2vw, 1.75rem);
    text-wrap: balance;
  }

  .hero__line {
    display: block;
    opacity: 0;
    transform: translateY(28px);
    animation: fadeInUp 1s var(--ease-out-expo) forwards;
  }
  .hero__line:nth-child(1) {
    animation-delay: 0.2s;
  }
  .hero__line:nth-child(2) {
    animation-delay: 0.35s;
  }
  .hero__line:nth-child(3) {
    animation-delay: 0.5s;
  }

  .hero__headline em {
    font-style: italic;
    font-weight: 500;
    color: var(--color-accent-ink);
    letter-spacing: -0.01em;
    padding-right: 0.05em;
  }

  [data-theme="dark"] .hero__headline em {
    color: var(--color-accent-ink);
  }

  .hero__period {
    color: var(--color-accent);
  }

  .hero__byline {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0 0 clamp(1.75rem, 3vw, 2.5rem);
    font-family: var(--font-mono);
    font-size: var(--fs-mono-md);
    letter-spacing: var(--tr-mono);
    color: var(--color-text-muted);
    flex-wrap: wrap;
    opacity: 0;
    animation: fadeInUp 0.9s 0.65s var(--ease-out-expo) forwards;
  }

  .hero__name {
    color: var(--color-text);
    font-weight: 500;
  }

  .hero__byline-rule {
    flex: 0 1 2.5rem;
    height: 1px;
    background: var(--color-rule);
  }

  .hero__byline-tags {
    font-variant-numeric: tabular-nums;
  }

  .hero__actions {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
    opacity: 0;
    animation: fadeInUp 0.9s 0.8s var(--ease-out-expo) forwards;
  }

  .btn {
    --btn-pad-x: 1.35rem;
    --btn-pad-y: 0.9rem;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: var(--btn-pad-y) var(--btn-pad-x);
    font-family: var(--font-mono);
    font-size: var(--fs-mono-md);
    letter-spacing: var(--tr-mono);
    text-transform: uppercase;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    border: 1px solid transparent;
    transition:
      transform 0.35s var(--ease-out-expo),
      background-color 0.3s var(--ease-out-expo),
      color 0.3s var(--ease-out-expo),
      border-color 0.3s var(--ease-out-expo);
  }

  .btn :global(svg) {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .btn--primary {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border-color: var(--color-accent);
  }

  .btn--primary:hover {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    transform: translateY(-2px);
  }

  .btn--primary :global(.btn__arrow) {
    transition: transform 0.4s var(--ease-out-expo);
  }

  .btn--primary:hover :global(.btn__arrow) {
    transform: translateX(4px);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-text);
    border-color: var(--color-rule);
  }

  .btn--ghost:hover {
    color: var(--color-accent-ink);
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .hero__aside {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    justify-self: stretch;
    margin-inline-start: calc(var(--stack-md) * -0.5);
    opacity: 0;
    transform: translateY(24px) rotate(0.4deg);
    animation: fadeInUp 1.1s 0.45s var(--ease-out-expo) forwards;
  }

  .hero__aside .hero__code {
    width: 100%;
  }

  .hero__code {
    position: relative;
    background: var(--tok-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
    font-family: var(--font-mono);
    box-shadow:
      0 1px 0 0 color-mix(in oklch, var(--color-text) 6%, transparent),
      0 30px 60px -30px color-mix(in oklch, var(--color-text) 25%, transparent);
    transform: rotate(-0.6deg);
  }

  .hero__code::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--color-accent) 0%,
      var(--color-accent) 30%,
      transparent 30%,
      transparent 100%
    );
  }

  .hero__code-chrome {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.75rem 1rem 0.6rem;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in oklch, var(--color-text) 3%, transparent);
  }

  .hero__code-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--color-rule);
  }

  .hero__code-dot:first-child {
    background: var(--color-accent);
  }

  .hero__code-file {
    margin-left: 0.6rem;
    font-size: var(--fs-mono-sm);
    letter-spacing: var(--tr-mono);
    color: var(--color-text-muted);
    text-transform: lowercase;
  }

  .hero__code-body {
    margin: 0;
    padding: 1.1rem 1.25rem 1.3rem;
    font-size: var(--fs-mono-md);
    line-height: 1.65;
    color: var(--color-text);
    overflow-x: auto;
    font-variant-numeric: tabular-nums;
    opacity: 0;
    animation: fadeInUp 0.8s 0.75s var(--ease-out-expo) forwards;
  }

  .hero__code-body code {
    font-family: inherit;
  }

  /* Tokens are injected via set:html and lack Astro's scope attribute — :global keeps selectors matching. */
  .hero__code-body :global(.cl) {
    display: block;
  }
  .hero__code-body :global(.cl--blank) {
    height: 0.6em;
  }
  .hero__code-body :global(.tok-kw) {
    color: var(--tok-kw);
    font-weight: 600;
  }
  .hero__code-body :global(.tok-type) {
    color: var(--tok-type);
    font-weight: 600;
  }
  .hero__code-body :global(.tok-prop) {
    color: var(--tok-prop);
  }
  .hero__code-body :global(.tok-str) {
    color: var(--tok-str);
  }
  .hero__code-body :global(.tok-fn) {
    color: var(--tok-fn);
  }
  .hero__code-body :global(.tok-bool) {
    color: var(--tok-bool);
    font-weight: 500;
  }
  .hero__code-body :global(.tok-punct) {
    color: var(--tok-punct);
  }
  .hero__code-body :global(.tok-comment) {
    color: var(--tok-comment);
    font-style: italic;
  }

  .hero__caption {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    padding-left: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    letter-spacing: var(--tr-mono);
    color: var(--color-text-muted);
    text-transform: lowercase;
    margin: 0;
  }

  .hero__caption-idx {
    color: var(--color-accent-ink);
    font-weight: 500;
  }

  .hero__footnote {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    letter-spacing: var(--tr-mono-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
    opacity: 0;
    animation: fadeInUp 0.9s 1.4s var(--ease-out-expo) forwards;
  }

  .hero__footnote-rule {
    flex: 1 1 auto;
    height: 1px;
    background: var(--color-rule);
  }

  @media (max-width: 640px) {
    .hero__headline {
      font-size: min(clamp(2.25rem, 10vw, 3.75rem), 11svh);
    }
    .hero__code {
      transform: none;
    }
    .hero__aside {
      transform: none;
    }
    .hero::after {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__mark,
    .hero__eyebrow,
    .hero__line,
    .hero__byline,
    .hero__actions,
    .hero__aside,
    .hero__footnote,
    .hero__code-body,
    .cl {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .hero__status-dot {
      animation: none;
    }
  }
</style>
