---
import ThemeToggle from "./ThemeToggle.astro"
---

<section
  class="relative min-h-screen flex flex-col justify-center px-6 py-20 overflow-hidden"
>
  <div
    class="absolute inset-0 bg-gradient-to-br from-accent/10 via-transparent to-accent/5 pointer-events-none"
  >
  </div>

  <div class="absolute top-6 right-6">
    <ThemeToggle />
  </div>

  <div class="max-w-4xl mx-auto w-full relative z-10">
    <p
      class="text-accent font-mono text-sm md:text-base mb-4 animate-fade-in-up"
    >
      Hi, my name is
    </p>

    <h1
      class="text-4xl md:text-6xl lg:text-7xl font-bold text-[var(--color-text)] mb-4 animate-fade-in-up delay-100"
    >
      Jordon de Hoog.
    </h1>

    <h2
      class="text-2xl sm:text-3xl md:text-5xl lg:text-6xl font-bold text-[var(--color-text-muted)] mb-6 animate-fade-in-up delay-200 whitespace-nowrap"
    >
      I build tools for Kotlin developers.
    </h2>

    <p
      class="text-lg md:text-xl text-[var(--color-text-muted)] max-w-2xl mb-10 leading-relaxed animate-fade-in-up delay-300"
    >
      <span class="text-accent">Android & Kotlin Multiplatform engineer</span>. Open source maintainer.
    </p>

    <div class="flex flex-wrap gap-4 animate-fade-in-up delay-400">
      <a
        href="#projects"
        class="inline-flex items-center px-6 py-3 rounded-lg border border-accent text-accent font-medium hover:bg-accent/10 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-[var(--color-bg)]"
      >
        View My Projects
        <svg
          class="w-4 h-4 ml-2"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 9l-7 7-7-7"></path>
        </svg>
      </a>
      <a
        href="https://github.com/jordond"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center px-6 py-3 rounded-lg border border-accent text-accent font-medium hover:bg-accent/10 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-[var(--color-bg)]"
      >
        <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
          ></path>
        </svg>
        GitHub
      </a>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-float">
    <svg
      class="w-6 h-6 text-[var(--color-text-muted)]"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</section>
