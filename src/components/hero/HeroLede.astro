---
import Icon from "../Icon.astro"
---

<div class="hero__lede">
  <p class="hero__eyebrow">
    <span class="hero__status" aria-hidden="true">
      <span class="hero__status-dot"></span>
    </span>
    <span>Available for hire</span>
    <span class="hero__eyebrow-sep" aria-hidden="true">·</span>
    <span>London, Ontario</span>
  </p>

  <h1 id="hero-headline" class="hero__headline" data-headline>
    <span class="hero__line" data-split
      >Android apps<span class="hero__period">.</span></span
    >
    <span class="hero__line" data-split
      ><em>Kotlin</em> libraries<span class="hero__period">.</span></span
    >
    <span class="hero__line" data-split
      >Open source, mostly<span class="hero__period">.</span></span
    >
  </h1>

  <p class="hero__byline">
    <span class="hero__name">Jordon de Hoog</span>
    <span class="hero__byline-rule" aria-hidden="true"></span>
    <span class="hero__byline-tags">Engineer · Maintainer · Tinkerer</span>
  </p>

  <div class="hero__actions">
    <a
      class="btn btn--primary"
      href="/resume.pdf"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Icon name="document" />
      <span>Résumé</span>
      <Icon name="arrow" class="btn__arrow" />
    </a>
    <a class="btn btn--ghost" href="mailto:jordon@jordond.dev">
      <Icon name="envelope" />
      <span>Email</span>
    </a>
    <a
      class="btn btn--ghost"
      href="https://linkedin.com/in/jordondehoog"
      target="_blank"
      rel="me noopener noreferrer"
      aria-label="LinkedIn profile"
    >
      <Icon name="linkedin" />
      <span>LinkedIn</span>
    </a>
  </div>
</div>

<style>
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    letter-spacing: var(--tr-mono-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: clamp(1.25rem, 2vw, 1.75rem);
  }

  .hero__eyebrow-sep {
    color: var(--color-rule);
  }

  .hero__status {
    position: relative;
    display: inline-flex;
    width: 0.6rem;
    height: 0.6rem;
  }

  .hero__status-dot {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 0 var(--color-accent-soft);
    animation: heroPulse 2.4s var(--ease-out-expo) infinite;
  }

  @keyframes heroPulse {
    0% {
      box-shadow: 0 0 0 0 var(--color-accent-soft);
    }
    70% {
      box-shadow: 0 0 0 0.55rem transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  .hero__headline {
    font-family: var(--font-display);
    font-weight: 900;
    /* svh cap keeps headline + byline + actions above the fold on short viewports. */
    font-size: min(clamp(2rem, 5.2vw + 0.25rem, 4.75rem), 10.5svh);
    line-height: 0.94;
    letter-spacing: var(--tr-display);
    color: var(--color-text);
    margin: 0 0 clamp(1rem, 2vw, 1.75rem);
    text-wrap: balance;
  }

  .hero__line {
    display: block;
  }

  /* JS-enhanced headline: overrides CSS fallback once characters are split. */
  .hero__headline.is-split .hero__line {
    opacity: 1;
    transform: none;
    animation: none;
  }
  .hero__headline.is-split :global(.ch) {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.9em);
    font-variation-settings: "wght" 300;
    will-change: transform, opacity, font-variation-settings;
  }
  .hero__headline.is-split em :global(.ch) {
    font-style: italic;
  }
  .hero__headline.is-split :global(.ch[data-space]) {
    width: 0.28em;
  }
  /* Cursor proximity: --d is 0..1 from nearest cursor, driven by JS. */
  .hero__headline.is-split.is-ready :global(.ch) {
    opacity: 1;
    font-variation-settings: "wght" calc(800 + var(--d, 0) * 100);
    transform: translateY(calc(var(--d, 0) * -3px))
      scale(calc(1 + var(--d, 0) * 0.035));
    transition:
      font-variation-settings 0.45s var(--ease-out-expo),
      transform 0.45s var(--ease-out-expo);
  }
  .hero__headline.is-split.is-ready em :global(.ch) {
    font-variation-settings: "wght" calc(800 + var(--d, 0) * 100);
  }

  .hero__headline em {
    font-style: italic;
    font-weight: 500;
    color: var(--color-accent-ink);
    letter-spacing: -0.01em;
    padding-right: 0.05em;
  }

  :global([data-theme="dark"]) .hero__headline em {
    color: var(--color-accent-ink);
  }

  .hero__period {
    color: var(--color-accent);
  }

  .hero__byline {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0 0 clamp(1.75rem, 3vw, 2.5rem);
    font-family: var(--font-mono);
    font-size: var(--fs-mono-md);
    letter-spacing: var(--tr-mono);
    color: var(--color-text-muted);
    flex-wrap: wrap;
  }

  .hero__name {
    color: var(--color-text);
    font-weight: 500;
  }

  .hero__byline-rule {
    flex: 0 1 2.5rem;
    height: 1px;
    background: var(--color-rule);
  }

  .hero__byline-tags {
    font-variant-numeric: tabular-nums;
  }

  .hero__actions {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .btn {
    --btn-pad-x: 1.35rem;
    --btn-pad-y: 0.9rem;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: var(--btn-pad-y) var(--btn-pad-x);
    font-family: var(--font-mono);
    font-size: var(--fs-mono-md);
    letter-spacing: var(--tr-mono);
    text-transform: uppercase;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    border: 1px solid transparent;
    transition:
      transform 0.35s var(--ease-out-expo),
      background-color 0.3s var(--ease-out-expo),
      color 0.3s var(--ease-out-expo),
      border-color 0.3s var(--ease-out-expo);
  }

  .btn :global(svg) {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .btn--primary {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border-color: var(--color-accent);
  }

  .btn--primary:hover {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    transform: translateY(-2px);
  }

  .btn--primary :global(.btn__arrow) {
    transition: transform 0.4s var(--ease-out-expo);
  }

  .btn--primary:hover :global(.btn__arrow) {
    transform: translateX(4px);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-text);
    border-color: var(--color-rule);
  }

  .btn--ghost:hover {
    color: var(--color-accent-ink);
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  @media (max-width: 640px) {
    .hero__headline {
      font-size: min(clamp(2.25rem, 10vw, 3.75rem), 11svh);
    }
    .hero__byline-rule {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__status-dot {
      animation: none;
    }
  }
</style>
