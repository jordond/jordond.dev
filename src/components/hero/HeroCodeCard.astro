---
interface Props {
  codeHtml: string
}

const { codeHtml } = Astro.props
---

<aside class="hero__aside">
  <div class="hero__code">
    <div class="hero__code-chrome">
      <span class="hero__code-dot"></span>
      <span class="hero__code-dot"></span>
      <span class="hero__code-dot"></span>
      <span class="hero__code-file">Jordon.kt</span>
    </div>
    <pre class="hero__code-body"><code set:html={codeHtml} /></pre>
  </div>
  <p class="hero__caption">
    <span class="hero__caption-idx">fig.&nbsp;01</span>
    Hello, in Kotlin.
  </p>
</aside>

<style>
  .hero__aside {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    justify-self: stretch;
    margin-inline-start: calc(var(--stack-md) * -0.5);
    opacity: 0;
    transform: translateY(24px) rotate(0.4deg);
    animation: fadeInUp 1.1s 0.45s var(--ease-out-expo) forwards;
  }

  .hero__aside .hero__code {
    width: 100%;
  }

  .hero__code {
    position: relative;
    background: var(--tok-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
    font-family: var(--font-mono);
    box-shadow:
      0 1px 0 0 color-mix(in oklch, var(--color-text) 6%, transparent),
      0 30px 60px -30px color-mix(in oklch, var(--color-text) 25%, transparent);
    transform: rotate(-0.6deg);
    transition:
      transform 0.6s var(--ease-out-expo),
      box-shadow 0.6s var(--ease-out-expo);
  }

  .hero__aside:hover .hero__code {
    transform: rotate(-0.2deg) translateY(-4px);
    box-shadow:
      0 2px 0 0 color-mix(in oklch, var(--color-text) 8%, transparent),
      0 45px 80px -30px color-mix(in oklch, var(--color-text) 32%, transparent);
  }

  .hero__code::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--color-accent) 0%,
      var(--color-accent) 30%,
      transparent 30%,
      transparent 100%
    );
  }

  .hero__code-chrome {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.75rem 1rem 0.6rem;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in oklch, var(--color-text) 3%, transparent);
  }

  .hero__code-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--color-rule);
  }

  .hero__code-dot:first-child {
    background: var(--color-accent);
  }

  .hero__code-file {
    margin-left: 0.6rem;
    font-size: var(--fs-mono-sm);
    letter-spacing: var(--tr-mono);
    color: var(--color-text-muted);
    text-transform: lowercase;
  }

  .hero__code-body {
    margin: 0;
    padding: 1.1rem 1.25rem 1.3rem;
    font-size: var(--fs-mono-md);
    line-height: 1.65;
    color: var(--color-text);
    overflow-x: auto;
    font-variant-numeric: tabular-nums;
    opacity: 0;
    animation: fadeInUp 0.8s 0.75s var(--ease-out-expo) forwards;
  }

  .hero__code-body code {
    font-family: inherit;
  }

  /* Tokens are injected via set:html and lack Astro's scope attribute — :global keeps selectors matching. */
  .hero__code-body :global(.cl) {
    display: block;
  }
  .hero__code-body :global(.cl--blank) {
    height: 0.6em;
  }
  .hero__code-body :global(.tok-kw) {
    color: var(--tok-kw);
    font-weight: 600;
  }
  .hero__code-body :global(.tok-type) {
    color: var(--tok-type);
    font-weight: 600;
  }
  .hero__code-body :global(.tok-prop) {
    color: var(--tok-prop);
  }
  .hero__code-body :global(.tok-str) {
    color: var(--tok-str);
  }
  .hero__code-body :global(.tok-fn) {
    color: var(--tok-fn);
  }
  .hero__code-body :global(.tok-bool) {
    color: var(--tok-bool);
    font-weight: 500;
  }
  .hero__code-body :global(.tok-punct) {
    color: var(--tok-punct);
  }
  .hero__code-body :global(.tok-comment) {
    color: var(--tok-comment);
    font-style: italic;
  }

  /* JS-enhanced typewriter: per-character visibility + caret. */
  :global(html.js) .hero__code-body {
    opacity: 1;
    animation: none;
  }
  :global(html.js) .hero__code-body :global(.cl) {
    position: relative;
  }
  :global(html.js) .hero__code-body :global(.tc) {
    font-style: inherit;
    visibility: hidden;
  }
  :global(html.js) .hero__code-body :global(.tc.is-typed) {
    visibility: visible;
  }
  :global(html.js) .hero__code-body :global(.tc.is-caret)::after {
    content: "";
    display: inline-block;
    width: 0.55ch;
    height: 1em;
    margin-left: 0.02em;
    vertical-align: -0.12em;
    background: var(--color-accent);
    animation: heroCaret 0.9s steps(1) infinite;
  }
  @keyframes heroCaret {
    50% {
      opacity: 0;
    }
  }

  /* Interactive library lines: hover lift + accent tooltip. */
  .hero__code-body :global(.cl--lib) {
    display: block;
    color: inherit;
    text-decoration: none;
    padding-inline: 0.25rem;
    margin-inline: -0.25rem;
    border-radius: 2px;
    transition:
      background-color 0.3s var(--ease-out-expo),
      transform 0.35s var(--ease-out-expo);
  }
  .hero__code-body :global(.cl--lib:hover) {
    background: color-mix(in oklch, var(--color-accent) 14%, transparent);
    transform: translateX(3px);
  }
  .hero__code-body :global(.cl--lib:focus-visible) {
    outline: none;
    background: color-mix(in oklch, var(--color-accent) 18%, transparent);
    box-shadow: inset 2px 0 0 0 var(--color-accent);
  }
  .hero__code-body :global(.cl--lib::after) {
    content: attr(data-tip);
    position: absolute;
    left: calc(100% + 0.9rem);
    top: 50%;
    transform: translate(-6px, -50%);
    padding: 0.35rem 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    letter-spacing: var(--tr-mono);
    white-space: nowrap;
    color: var(--color-accent-contrast);
    background: var(--color-accent);
    border-radius: 3px;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.3s var(--ease-out-expo),
      transform 0.35s var(--ease-out-expo);
    z-index: 3;
  }
  .hero__code-body :global(.cl--lib:hover::after),
  .hero__code-body :global(.cl--lib:focus-visible::after) {
    opacity: 1;
    transform: translate(0, -50%);
  }
  @media (max-width: 1100px) {
    .hero__code-body :global(.cl--lib::after) {
      left: auto;
      right: 0.25rem;
      top: -1.7em;
      transform: translate(6px, 0);
    }
    .hero__code-body :global(.cl--lib:hover::after),
    .hero__code-body :global(.cl--lib:focus-visible::after) {
      transform: translate(0, 0);
    }
  }

  .star-count {
    font-variant-numeric: tabular-nums;
    display: inline-block;
    min-width: 1.6ch;
  }

  .hero__caption {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    padding-left: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    letter-spacing: var(--tr-mono);
    color: var(--color-text-muted);
    text-transform: lowercase;
    margin: 0;
  }

  .hero__caption-idx {
    color: var(--color-accent-ink);
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .hero__aside {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__aside,
    .hero__code-body {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .hero__code-body :global(.cl) {
      opacity: 1;
      transform: none;
      animation: none;
    }
    :global(html.js) .hero__code-body :global(.tc) {
      visibility: visible;
    }
    :global(html.js) .hero__code-body :global(.tc.is-caret)::after {
      display: none;
    }
  }
</style>
