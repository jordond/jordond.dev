---
import { Image } from "astro:assets"
import { community } from "../config/data"
import SectionHeader from "./SectionHeader.astro"
import Icon from "./Icon.astro"

const pad = (n: number) => String(n).padStart(2, "0")
---

<section id="community" class="section community">
  <div class="section__inner">
    <SectionHeader index="§ 03 · community" kicker="Writing & talks">
      <Fragment slot="title">
        Out <em>loud</em>.
      </Fragment>
      <Fragment slot="lead">
        Conference talks, podcast episodes, and the occasional essay. Thinking
        out loud about the work.
      </Fragment>
    </SectionHeader>

    <div class="community__list">
      {
        community.map((item, index) => (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="community__item animate-on-scroll"
            style={`transition-delay: ${(index + 1) * 100}ms`}
            data-side={index % 2 === 0 ? "left" : "right"}
          >
            <article class="community__article">
              <span class="community__idx">no. {pad(index + 1)}</span>

              {item.videoId && (
                <div class="community__thumb">
                  <Image
                    src={`https://img.youtube.com/vi/${item.videoId}/maxresdefault.jpg`}
                    alt={`${item.title} thumbnail`}
                    width={1280}
                    height={720}
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="community__play" aria-hidden="true">
                    <Icon name="play" />
                  </div>
                </div>
              )}

              <div class="community__body">
                <div class="community__meta">
                  <span class="community__role">{item.role}</span>
                  <span class="community__sep" aria-hidden="true">
                    ·
                  </span>
                  <span class="community__source">{item.source}</span>
                </div>

                <h3 class="community__title">{item.title}</h3>

                <p class="community__desc">{item.description}</p>

                <div class="community__cta">
                  <span>{item.videoId ? "Watch" : "Read"}</span>
                  <Icon name="arrow" />
                </div>
              </div>
            </article>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .community__list {
    display: flex;
    flex-direction: column;
    gap: var(--stack-md);
  }

  /* Every third item breaks the stack into visual paragraphs. */
  .community__item:nth-child(3n + 1):not(:first-child) {
    margin-top: var(--stack-lg);
  }

  .community__item {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .community__article {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--stack-md);
    align-items: center;
    padding: var(--space-sm) 0;
    border-top: 1px solid var(--color-rule);
    transition: border-color 0.4s var(--ease-out-expo);
  }

  .community__item:hover .community__article {
    border-top-color: var(--color-accent);
  }

  .community__article:has(.community__thumb:empty),
  .community__article:not(:has(.community__thumb)) {
    grid-template-columns: auto minmax(0, 1fr);
  }

  .community__item[data-side="right"] .community__article {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
  }

  .community__item[data-side="right"] .community__thumb {
    order: 2;
  }

  .community__item[data-side="right"] .community__body {
    order: 1;
  }

  @media (max-width: 760px) {
    .community__article,
    .community__item[data-side="right"] .community__article {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .community__item[data-side="right"] .community__thumb,
    .community__item[data-side="right"] .community__body {
      order: initial;
    }
  }

  .community__idx {
    position: absolute;
    top: 0.85rem;
    right: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    letter-spacing: var(--tr-mono-caps);
    text-transform: uppercase;
    color: var(--color-accent-ink);
    font-variant-numeric: tabular-nums;
  }

  .community__thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
  }

  .community__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out-expo);
    filter: grayscale(0.1);
  }

  .community__item:hover .community__thumb img {
    transform: scale(1.05);
    filter: grayscale(0);
  }

  .community__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in oklch, var(--color-text) 40%, transparent);
    opacity: 0;
    transition: opacity 0.35s var(--ease-out-expo);
  }

  .community__play :global(svg) {
    width: 3rem;
    height: 3rem;
    color: var(--color-accent-contrast);
    background: var(--color-accent);
    padding: 0.75rem 0.65rem 0.75rem 0.85rem;
    border-radius: 999px;
  }

  .community__item:hover .community__play {
    opacity: 1;
  }

  .community__body {
    min-width: 0;
  }

  .community__meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    letter-spacing: var(--tr-mono-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 0.85rem;
  }

  .community__role {
    color: var(--color-accent-ink);
    font-weight: 500;
  }

  .community__sep {
    color: var(--color-rule);
  }

  .community__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-title-2);
    line-height: var(--lh-heading);
    letter-spacing: var(--tr-title);
    color: var(--color-text);
    margin: 0 0 0.85rem;
    transition: color 0.35s var(--ease-out-expo);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .community__item:hover .community__title {
    color: var(--color-accent);
  }

  .community__desc {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    line-height: var(--lh-prose);
    color: var(--color-text-muted);
    margin: 0 0 1.1rem;
    max-width: 60ch;
    text-wrap: pretty;
  }

  .community__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    letter-spacing: var(--tr-mono-caps);
    text-transform: uppercase;
    color: var(--color-accent-ink);
    font-weight: 500;
  }

  .community__cta :global(svg) {
    width: 1rem;
    height: 1rem;
    transition: transform 0.4s var(--ease-out-expo);
  }

  .community__item:hover .community__cta :global(svg) {
    transform: translateX(4px);
  }
</style>
