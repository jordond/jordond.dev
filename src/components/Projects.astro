---
import RepoCard from "./RepoCard.astro"
import type { RepoData } from "../types/repo"
import reposData from "../data/repos.json"

const repos: RepoData[] = (reposData as RepoData[]).toSorted(
  (a, b) => b.stargazers_count - a.stargazers_count
)
---

<section id="projects" class="py-20 px-6">
  <div class="max-w-6xl mx-auto">
    <h2
      class="flex items-center text-2xl md:text-3xl font-bold text-[var(--color-text)] mb-12 animate-on-scroll"
    >
      <span class="text-accent font-mono text-xl mr-2">02.</span>
      Projects
      <span class="ml-4 h-px flex-1 bg-[var(--color-surface-elevated)]"></span>
    </h2>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {repos.map((repo, index) => <RepoCard repo={repo} index={index} />)}
    </div>
  </div>
</section>

<script>
  async function updateStarCounts() {
    const starElements = document.querySelectorAll<HTMLElement>(
      ".star-count[data-repo]",
    )
    if (starElements.length === 0) return

    const repos = Array.from(starElements)
      .map((el) => el.dataset.repo)
      .filter(Boolean) as string[]

    const results = await Promise.allSettled(
      repos.map(async (repo) => {
        const response = await fetch(`https://api.github.com/repos/${repo}`, {
          headers: { Accept: "application/vnd.github.v3+json" },
        })
        if (!response.ok) throw new Error(`Failed to fetch ${repo}`)
        const data = await response.json()
        return { repo, stars: data.stargazers_count }
      }),
    )

    results.forEach((result) => {
      if (result.status === "fulfilled") {
        const { repo, stars } = result.value
        const element = document.querySelector<HTMLElement>(
          `.star-count[data-repo="${repo}"]`,
        )
        if (element) {
          element.textContent = stars.toLocaleString()
        }
      }
    })
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () =>
      setTimeout(updateStarCounts, 1000),
    )
  } else {
    setTimeout(updateStarCounts, 1000)
  }
</script>
