---
import RepoCard from "./RepoCard.astro"
import type { RepoData } from "../types/repo"
import reposData from "../data/repos.json"

const allRepos: RepoData[] = (reposData as RepoData[]).toSorted(
  (a, b) => b.stargazers_count - a.stargazers_count,
)

const featuredRepos = allRepos.filter((repo) => repo.featured)
const otherRepos = allRepos.filter((repo) => !repo.featured)
---

<section id="projects" class="py-20 px-6">
  <div class="max-w-6xl mx-auto">
    <h2
      class="flex items-center text-2xl md:text-3xl font-bold text-[var(--color-text)] mb-12 animate-on-scroll"
    >
      <span class="text-accent font-mono text-xl mr-2">02.</span>
      Projects
      <span class="ml-4 h-px flex-1 bg-[var(--color-surface-elevated)]"></span>
    </h2>

    {
      featuredRepos.length > 0 && (
        <div class="mb-12">
          <p class="text-sm uppercase tracking-wider text-[var(--color-text-muted)] mb-6 font-mono animate-on-scroll">
            Featured
          </p>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {featuredRepos.map((repo, index) => (
              <RepoCard repo={repo} index={index} featured />
            ))}
          </div>
        </div>
      )
    }

    {
      otherRepos.length > 0 && (
        <div>
          <p class="text-sm uppercase tracking-wider text-[var(--color-text-muted)] mb-6 font-mono animate-on-scroll">
            Other Projects
          </p>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {otherRepos.map((repo, index) => (
              <RepoCard repo={repo} index={index + featuredRepos.length} />
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>
