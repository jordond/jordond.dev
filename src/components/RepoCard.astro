---
import type { RepoData } from "../types/repo"

interface Props {
  repo: RepoData
  index?: number
  featured?: boolean
}

const { repo, index = 0, featured = false } = Astro.props

const languageColors: Record<string, string> = {
  Kotlin: "#A97BFF",
  Rust: "#DEA584",
  TypeScript: "#3178C6",
  JavaScript: "#F7DF1E",
}

const langColor = languageColors[repo.language || ""] || "#6B7280"
const delay = `delay-${((index % 5) + 1) * 100}`

const primaryUrl = repo.homepage || repo.html_url
const primaryLabel = repo.homepage ? "View Project" : "View on GitHub"
---

<article
  class:list={[
    "group relative rounded-xl p-6 animate-on-scroll",
    delay,
    featured
      ? "bg-gradient-to-br from-accent/10 via-[var(--color-surface)] to-accent/20 border border-accent/30"
      : "bg-[var(--color-surface)] border border-[var(--color-surface-elevated)]",
  ]}
>
  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-3">
      {
        repo.type === "library" ? (
          <svg
            class="w-8 h-8 text-accent flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
            />
          </svg>
        ) : (
          <svg
            class="w-8 h-8 text-accent flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
            />
          </svg>
        )
      }
      <h3
        class="text-xl font-semibold text-[var(--color-text)] group-hover:text-accent transition-colors duration-300 ease-out"
      >
        <a
          href={repo.html_url}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:underline"
        >
          {repo.name}
        </a>
      </h3>
    </div>

    <div class="flex items-center gap-3">
      <a
        href={repo.html_url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-[var(--color-text-muted)] hover:text-accent transition-colors"
        aria-label={`View ${repo.name} on GitHub`}
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
          ></path>
        </svg>
      </a>
      {
        repo.homepage && (
          <a
            href={repo.homepage}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--color-text-muted)] hover:text-accent transition-colors"
            aria-label={`Visit ${repo.name} website`}
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              />
            </svg>
          </a>
        )
      }
    </div>
  </div>

  <p
    class="text-[var(--color-text-muted)] text-sm mb-4 line-clamp-2 min-h-[40px]"
  >
    {repo.description || "No description available"}
  </p>

  <div
    class="flex flex-wrap items-center gap-4 text-xs text-[var(--color-text-muted)]"
  >
    {
      repo.language && (
        <span class="flex items-center gap-1">
          <span
            class="w-3 h-3 rounded-full"
            style={`background-color: ${langColor}`}
          />
          {repo.language}
        </span>
      )
    }

    <span class="flex items-center gap-1">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <path
          d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
        ></path>
      </svg>
      <span data-repo={repo.full_name} class="star-count"
        >{repo.stargazers_count.toLocaleString()}</span
      >
    </span>
  </div>

  {
    repo.topics && repo.topics.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-4">
        {repo.topics.slice(0, 4).map((topic) => (
          <span class="px-2 py-1 text-xs rounded-full bg-accent/10 text-accent">
            {topic}
          </span>
        ))}
      </div>
    )
  }
</article>

<style>
  article {
    transition:
      border-color 0.3s ease-out,
      opacity 0.6s ease,
      transform 0.6s ease !important;
  }
  article:hover {
    border-color: var(--color-accent) !important;
  }
</style>
