---
import type { RepoData } from "../types/repo"

interface Props {
  repo: RepoData
  index?: number
}

const { repo, index = 0 } = Astro.props

const languageColors: Record<string, string> = {
  Kotlin: "#A97BFF",
  Rust: "#DEA584",
  TypeScript: "#3178C6",
  JavaScript: "#F7DF1E",
}

const langColor = languageColors[repo.language || ""] || "#6B7280"
const delay = `delay-${((index % 5) + 1) * 100}`

const isApp = repo.type === "app"
const isTool = repo.type === "tool"
---

<article
  class:list={[
    "group relative rounded-xl animate-on-scroll flex flex-col overflow-hidden",
    delay,
    isApp ? "lg:flex-row lg:col-span-2 xl:col-span-3" : "h-full p-6",
    "bg-[var(--color-surface)] border border-[var(--color-surface-elevated)]",
  ]}
>
  {
    isApp && repo.image && (
      <div class="lg:w-2/5 xl:w-1/2 overflow-hidden border-b lg:border-b-0 lg:border-r border-[var(--color-surface-elevated)] aspect-video lg:aspect-auto">
        <img
          src={repo.image}
          alt={`${repo.name} preview`}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }

  <div class:list={["flex flex-col flex-1", isApp ? "p-6 lg:p-8" : ""]}>
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-3">
        {
          repo.type === "library" ? (
            <svg
              class="w-8 h-8 text-accent flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
              />
            </svg>
          ) : isTool ? (
            <svg
              class="w-8 h-8 text-accent flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              />
            </svg>
          ) : (
            <svg
              class="w-8 h-8 text-accent flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
              />
            </svg>
          )
        }
        <h3
          class="text-xl font-semibold text-[var(--color-text)] group-hover:text-accent transition-colors duration-300 ease-out"
        >
          <a
            href={repo.html_url || repo.homepage}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:underline"
          >
            {repo.name}
          </a>
        </h3>
      </div>

      <div class="flex items-center gap-3">
        {
          repo.links?.playStore && (
            <a
              href={repo.links.playStore}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--color-text-muted)] hover:text-accent transition-colors"
              title="Get it on Google Play"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 16 16">
                <path d="M14.222 9.374c1.037-.61 1.037-2.137 0-2.748L11.528 5.04 8.32 8l3.207 2.96zm-3.595 2.116L7.583 8.68 1.03 14.73c.201 1.029 1.36 1.61 2.303 1.055zM1 13.396V2.603L6.846 8zM1.03 1.27l6.553 6.05 3.044-2.81L3.333.215C2.39-.341 1.231.24 1.03 1.27" />
              </svg>
            </a>
          )
        }
        {
          repo.links?.appStore && (
            <a
              href={repo.links.appStore}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--color-text-muted)] hover:text-accent transition-colors"
              title="Download on the App Store"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.71 19.5C17.88 20.74 17 21.95 15.66 21.97C14.32 22 13.89 21.18 12.37 21.18C10.84 21.18 10.37 21.95 9.09997 22C7.78997 22.05 6.79997 20.68 5.95997 19.47C4.24997 17 2.93997 12.45 4.69997 9.39C5.56997 7.87 7.12997 6.91 8.81997 6.88C10.1 6.86 11.32 7.75 12.11 7.75C12.89 7.75 14.37 6.68 15.92 6.84C16.57 6.87 18.39 7.1 19.56 8.82C19.47 8.88 17.39 10.1 17.41 12.63C17.44 15.65 20.06 16.66 20.09 16.67C20.06 16.74 19.67 18.11 18.71 19.5ZM13 3.5C13.73 2.67 14.94 2.04 15.94 2C16.07 3.17 15.6 4.35 14.9 5.19C14.21 6.04 13.07 6.7 11.95 6.61C11.8 5.46 12.36 4.26 13 3.5Z" />
              </svg>
            </a>
          )
        }
        {
          repo.links?.macos && (
            <a
              href={repo.links.macos}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--color-text-muted)] hover:text-accent transition-colors"
              title="Download for macOS"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                />
              </svg>
            </a>
          )
        }
        {
          repo.links?.windows && (
            <a
              href={repo.links.windows}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--color-text-muted)] hover:text-accent transition-colors"
              title="Download for Windows"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M0 3.449L9.75 2.1V11.7H0V3.449zm0 17.1L9.75 21.9V12.3H0v8.249zM10.5 2V11.7H24V0L10.5 2zm0 19.9L24 24V12.3H10.5v9.6z" />
              </svg>
            </a>
          )
        }
        {
          repo.links?.linux && (
            <a
              href={repo.links.linux}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--color-text-muted)] hover:text-accent transition-colors"
              title="Download for Linux"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2c-.933 0-1.8.311-2.5.833-.7.522-1.217 1.256-1.5 2.167-.283.911-.267 1.933.05 2.883.317.95.883 1.783 1.6 2.383-.717.6-1.283 1.433-1.6 2.383-.317.95-.333 1.972-.05 2.883.283.911.8 1.645 1.5 2.167.7.522 1.567.833 2.5.833.933 0 1.8-.311 2.5-.833.7-.522 1.217-1.256 1.5-2.167.283-.911.267-1.933-.05-2.883-.317-.95-.883-1.783-1.6-2.383.717-.6 1.283-1.433 1.6-2.383.317-.95.333-1.972.05-2.883-.283-.911-.8-1.645-1.5-2.167-.7-.522-1.567-.833-2.5-.833z" />
              </svg>
            </a>
          )
        }
        {
          repo.html_url && (
            <a
              href={repo.html_url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--color-text-muted)] hover:text-accent transition-colors"
              aria-label={`View ${repo.name} on GitHub`}
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
            </a>
          )
        }
        {
          repo.homepage && (
            <a
              href={repo.homepage}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--color-text-muted)] hover:text-accent transition-colors"
              aria-label={`Visit ${repo.name} website`}
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                />
              </svg>
            </a>
          )
        }
      </div>
    </div>

    <p
      class:list={[
        "text-[var(--color-text-muted)] text-sm mb-4 line-clamp-3",
        isApp ? "lg:line-clamp-none lg:text-base" : "min-h-[60px]",
      ]}
    >
      {repo.description || "No description available"}
    </p>

    <div class="mt-auto">
      <div
        class="flex flex-wrap items-center gap-4 text-xs text-[var(--color-text-muted)] mb-4"
      >
        {
          repo.language && (
            <span class="flex items-center gap-1">
              <span
                class="w-3 h-3 rounded-full"
                style={`background-color: ${langColor}`}
              />
              {repo.language}
            </span>
          )
        }

        {
          repo.stargazers_count > 0 && (
            <span class="flex items-center gap-1">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
              </svg>
              <span data-repo={repo.full_name} class="star-count">
                {repo.stargazers_count.toLocaleString()}
              </span>
            </span>
          )
        }
      </div>

      {
        repo.topics && repo.topics.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {repo.topics.slice(0, isApp ? 8 : 4).map((topic) => (
              <span class="font-sans topic-tag px-2 py-1 text-xs rounded-full bg-accent/10 text-accent border border-accent/20">
                {topic}
              </span>
            ))}
          </div>
        )
      }
    </div>
  </div>
</article>

<style>
  article {
    transition:
      border-color 0.3s ease-out,
      opacity 0.6s ease,
      transform 0.6s ease !important;
  }
  article:hover {
    border-color: var(--color-accent) !important;
  }
</style>
