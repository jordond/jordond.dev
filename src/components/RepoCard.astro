---
import { Image } from "astro:assets"
import type { RepoData } from "../types/repo"
import Icon from "./Icon.astro"

interface Props {
  repo: RepoData
  index?: number
}

const { repo, index = 0 } = Astro.props

const languageColors: Record<string, string> = {
  Kotlin: "oklch(0.70 0.19 295)",
  Rust: "oklch(0.72 0.14 55)",
  TypeScript: "oklch(0.62 0.16 245)",
  JavaScript: "oklch(0.86 0.17 95)",
}

const langColor =
  languageColors[repo.language || ""] || "var(--color-text-muted)"
const delay = `delay-${((index % 5) + 1) * 100}`

const isApp = repo.type === "app"
const typeLabel =
  repo.type === "library"
    ? "Library"
    : repo.type === "tool"
      ? "Tool"
      : "Application"
const langLabel = repo.language || "Kotlin"
/* Badge is app-only: tools/libraries always link to GitHub, so flagging them as open source would be noise. */
const isOpenSourceApp = isApp && !!repo.html_url

/* Build-time glob keyed by filename sans extension. */
const localApps = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/apps/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
)
const appImageByKey: Record<string, ImageMetadata> = {}
for (const [p, mod] of Object.entries(localApps)) {
  const key = p
    .split("/")
    .pop()!
    .replace(/\.[^.]+$/, "")
  appImageByKey[key] = mod.default
}

const localAppImage =
  isApp && repo.image && !repo.image.startsWith("http")
    ? appImageByKey[repo.image]
    : undefined
const remoteAppImage =
  isApp && repo.image && repo.image.startsWith("http") ? repo.image : undefined
---

<article
  class:list={["card animate-on-scroll", delay, isApp && "card--featured"]}
>
  {
    localAppImage && (
      <div class="card__media">
        <Image
          src={localAppImage}
          alt={`${repo.name} preview`}
          class="card__image"
          widths={[400, 800, 1200, 1600]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }
  {
    !localAppImage && remoteAppImage && (
      <div class="card__media">
        <Image
          src={remoteAppImage}
          alt={`${repo.name} preview`}
          class="card__image"
          width={1200}
          height={630}
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }

  <div class="card__body">
    <div class="card__head">
      <p class="card__kicker">
        <span class="card__lang-dot" style={`background: ${langColor}`}></span>
        <span>{langLabel}</span>
        <span class="card__kicker-sep" aria-hidden="true">/</span>
        <span>{typeLabel}</span>
        {
          isOpenSourceApp && (
            <>
              <span class="card__kicker-sep" aria-hidden="true">
                ·
              </span>
              <span class="card__oss">Open Source</span>
            </>
          )
        }
      </p>

      <h4 class="card__title">
        <a
          href={repo.html_url || repo.homepage}
          target="_blank"
          rel="noopener noreferrer"
        >
          {repo.name}
        </a>
      </h4>
    </div>

    <p class="card__desc">{repo.description || "No description."}</p>

    {
      isApp && (
        <div class="card__ctas">
          {repo.links?.playStore && (
            <a
              href={repo.links.playStore}
              target="_blank"
              rel="noopener noreferrer"
              class="card__cta card__cta--primary"
            >
              <Icon name="playStore" />
              <span>Google Play</span>
            </a>
          )}
          {repo.links?.appStore && (
            <a
              href={repo.links.appStore}
              target="_blank"
              rel="noopener noreferrer"
              class="card__cta card__cta--primary"
            >
              <Icon name="appStore" />
              <span>App Store</span>
            </a>
          )}
          {repo.homepage && (
            <a
              href={repo.homepage}
              target="_blank"
              rel="noopener noreferrer"
              class="card__cta"
            >
              <Icon name="external" />
              <span>Visit site</span>
            </a>
          )}
          {repo.html_url && (
            <a
              href={repo.html_url}
              target="_blank"
              rel="noopener noreferrer"
              class="card__cta"
            >
              <Icon name="github" />
              <span>Source</span>
            </a>
          )}
        </div>
      )
    }

    <div class="card__foot">
      {
        repo.topics && repo.topics.length > 0 && (
          <div class="card__chips">
            {repo.topics.slice(0, isApp ? 8 : 4).map((topic) => (
              <span class="chip">{topic}</span>
            ))}
          </div>
        )
      }

      <div class="card__stats">
        {
          repo.stargazers_count > 0 && (
            <span class="card__stat">
              <span data-repo={repo.full_name} class="star-count">
                {repo.stargazers_count.toLocaleString()}
              </span>
              <span class="card__stat-label">stars on github</span>
            </span>
          )
        }

        <div class="card__links">
          {
            !isApp && repo.links?.playStore && (
              <a
                href={repo.links.playStore}
                target="_blank"
                rel="noopener noreferrer"
                class="card__link"
                title="Get it on Google Play"
                aria-label="Google Play"
              >
                <Icon name="playStore" />
              </a>
            )
          }
          {
            !isApp && repo.links?.appStore && (
              <a
                href={repo.links.appStore}
                target="_blank"
                rel="noopener noreferrer"
                class="card__link"
                title="Download on the App Store"
                aria-label="App Store"
              >
                <Icon name="appStore" />
              </a>
            )
          }
          {
            repo.links?.macos && (
              <a
                href={repo.links.macos}
                target="_blank"
                rel="noopener noreferrer"
                class="card__link"
                title="Download for macOS"
                aria-label="macOS"
              >
                <Icon name="macos" />
              </a>
            )
          }
          {
            repo.links?.windows && (
              <a
                href={repo.links.windows}
                target="_blank"
                rel="noopener noreferrer"
                class="card__link"
                title="Download for Windows"
                aria-label="Windows"
              >
                <Icon name="windows" />
              </a>
            )
          }
          {
            repo.links?.linux && (
              <a
                href={repo.links.linux}
                target="_blank"
                rel="noopener noreferrer"
                class="card__link"
                title="Download for Linux"
                aria-label="Linux"
              >
                <Icon name="linux" />
              </a>
            )
          }
          {
            !isApp && repo.html_url && (
              <a
                href={repo.html_url}
                target="_blank"
                rel="noopener noreferrer"
                class="card__link"
                aria-label={`View ${repo.name} on GitHub`}
                title="View on GitHub"
              >
                <Icon name="github" />
              </a>
            )
          }
          {
            !isApp && repo.homepage && (
              <a
                href={repo.homepage}
                target="_blank"
                rel="noopener noreferrer"
                class="card__link"
                aria-label={`Visit ${repo.name} website`}
                title="Visit website"
              >
                <Icon name="external" />
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: clamp(1.25rem, 2vw, 1.75rem);
    transition:
      border-color 0.4s var(--ease-out-expo),
      transform 0.4s var(--ease-out-expo),
      box-shadow 0.4s var(--ease-out-expo);
  }

  .card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow:
      0 1px 0 0 color-mix(in oklch, var(--color-text) 6%, transparent),
      0 24px 48px -28px color-mix(in oklch, var(--color-text) 30%, transparent);
  }

  .card--featured {
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    min-height: 0;
  }

  @media (min-width: 720px) {
    .card--featured {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      align-items: stretch;
    }
  }

  .card__media {
    position: relative;
    overflow: hidden;
    background: var(--color-surface-elevated);
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 720px) {
    .card__media {
      aspect-ratio: auto;
      border-bottom: 0;
      border-right: 1px solid var(--color-border);
    }
  }

  .card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out-expo);
  }

  .card:hover .card__image {
    transform: scale(1.03);
  }

  .card--featured .card__body {
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 1.1rem;
  }

  .card__head {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .card__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    letter-spacing: var(--tr-mono-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
  }

  .card__lang-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    flex-shrink: 0;
  }

  .card__kicker-sep {
    color: var(--color-rule);
  }

  .card__oss {
    color: var(--color-accent-ink);
    font-weight: 500;
  }

  .card__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-title-2);
    line-height: var(--lh-tight);
    letter-spacing: var(--tr-title);
    color: var(--color-text);
    margin: 0;
    transition: color 0.35s var(--ease-out-expo);
    text-wrap: balance;
    overflow-wrap: anywhere; /* long repo slugs like compose-resources-kit */
  }

  .card--featured .card__title {
    font-size: var(--fs-display-sm);
    line-height: var(--lh-display);
    letter-spacing: var(--tr-heading);
  }

  .card__title a {
    color: inherit;
    text-decoration: none;
  }

  .card:hover .card__title {
    color: var(--color-accent);
  }

  .card__desc {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    line-height: var(--lh-prose);
    color: var(--color-text-muted);
    margin: 0;
    min-height: 3em;
    white-space: pre-line;
    max-width: 60ch;
    text-wrap: pretty;
  }

  .card--featured .card__desc {
    font-size: var(--fs-body-sm);
    line-height: 1.55;
    min-height: 0;
  }

  .card__foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .card__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.25rem;
  }

  .card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 0.95rem;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    letter-spacing: var(--tr-mono-caps);
    text-transform: uppercase;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    color: var(--color-text);
    border: 1px solid var(--color-rule);
    transition:
      color 0.3s var(--ease-out-expo),
      border-color 0.3s var(--ease-out-expo),
      background-color 0.3s var(--ease-out-expo),
      transform 0.35s var(--ease-out-expo);
  }

  .card__cta :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
    flex-shrink: 0;
  }

  .card__cta:hover {
    color: var(--color-accent-ink);
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .card__cta--primary {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border-color: var(--color-accent);
  }

  .card__cta--primary:hover {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    color: var(--color-accent-contrast);
  }

  .card__stats {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-rule);
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    letter-spacing: var(--tr-mono);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .card__stat {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    text-transform: uppercase;
    letter-spacing: var(--tr-mono-caps);
  }

  .card__stat .star-count {
    color: var(--color-accent-ink);
    font-weight: 500;
  }

  .card__stat-label {
    color: var(--color-text-muted);
  }

  .card__links {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    margin-left: auto;
  }

  .card__link {
    color: var(--color-text-muted);
    display: inline-flex;
    /* Expand hit area to ~36px without shifting visual layout (WCAG 2.5.8) */
    padding: 0.5rem;
    margin: -0.5rem;
    transition: color 0.3s var(--ease-out-expo);
  }

  .card__link:hover {
    color: var(--color-accent-ink);
  }

  .card__link :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }
</style>
