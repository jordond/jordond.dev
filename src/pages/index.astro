---
import reposData from "../data/repos.json"

const apps = reposData.apps
const tools = reposData.tools
const libraries = reposData.libraries

const sortedLibraries = libraries
  .slice()
  .sort((a, b) => b.stargazers_count - a.stargazers_count)

const totalStars = [...tools, ...libraries].reduce(
  (sum, r) => sum + (r.stargazers_count ?? 0),
  0,
)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Jordon de Hoog : Software Engineer</title>
    <meta
      name="description"
      content="Jordon de Hoog. Software engineer specializing in Kotlin, Kotlin Multiplatform, and Android. Open source author of MaterialKolor, connectivity, and compass."
    />
    <meta name="author" content="Jordon de Hoog" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      html {
        background: #008080;
      }
      body {
        font-family: "Times New Roman", Times, serif;
        font-size: 16px;
        line-height: 1.5;
        color: #000000;
        background: #c0c0c0;
        max-width: 760px;
        margin: 16px auto;
        padding: 16px 24px 28px 24px;
        border: 4px ridge #808080;
      }
      a:link {
        color: #0000ee;
        text-decoration: underline;
      }
      a:visited {
        color: #551a8b;
        text-decoration: underline;
      }
      a:active {
        color: #ff0000;
      }
      h1 {
        font-size: 32px;
        font-weight: bold;
        margin: 0 0 2px 0;
      }
      h2 {
        font-size: 20px;
        font-weight: bold;
        background: #000080;
        color: #ffff00;
        padding: 5px 10px;
        border: 2px outset #c0c0c0;
        margin: 26px 0 10px 0;
      }
      h3 {
        font-size: 17px;
        font-weight: bold;
        margin: 14px 0 2px 0;
      }
      h3.subsection {
        font-family: "Courier New", Courier, monospace;
        font-size: 13px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #000000;
        margin: 20px 0 4px 0;
      }
      h3.subsection::before {
        content: "// ";
        color: #808080;
      }
      p {
        margin: 6px 0;
      }
      hr {
        border: 0;
        border-top: 2px groove #808080;
        margin: 18px 0;
      }
      ul {
        margin: 4px 0 8px 0;
        padding-left: 24px;
      }
      ul.bullets {
        list-style: square;
      }
      li {
        margin: 2px 0;
      }
      dl {
        margin: 4px 0 8px 0;
      }
      dt {
        float: left;
        clear: left;
        width: 90px;
        font-weight: bold;
      }
      dd {
        margin: 0 0 2px 100px;
      }
      table.projects {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        background: #d4d0c8;
        border: 3px outset #c0c0c0;
        margin: 8px 0 12px 0;
      }
      table.projects th {
        text-align: left;
        background: #000080;
        color: #ffffff;
        padding: 5px 8px;
        font-family: "Courier New", Courier, monospace;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      table.projects td {
        text-align: left;
        vertical-align: top;
        padding: 6px 8px;
        border-top: 1px solid #808080;
        font-size: 15px;
      }
      table.projects td.stars {
        text-align: right;
        white-space: nowrap;
        font-family: "Courier New", Courier, monospace;
        font-size: 14px;
        color: #b8860b;
        font-weight: bold;
      }
      .meta {
        font-size: 12px;
        color: #444444;
        font-family: "Courier New", Courier, monospace;
      }
      .topnav {
        text-align: center;
        background: #000080;
        color: #ffffff;
        padding: 6px 8px;
        border: 2px outset #c0c0c0;
        font-family: "Courier New", Courier, monospace;
        font-size: 13px;
        margin: 10px 0 14px 0;
      }
      .topnav a:link,
      .topnav a:visited {
        color: #ffff00;
      }
      .status {
        background: #ffffcc;
        border-left: 4px solid #ff8c00;
        border-top: 1px solid #808080;
        border-right: 1px solid #808080;
        border-bottom: 1px solid #808080;
        padding: 8px 12px;
        margin: 12px 0 14px 0;
        font-size: 15px;
      }
      .status b {
        color: #006400;
      }
      .desc {
        color: #000000;
      }
      address {
        font-style: normal;
        font-size: 12px;
        color: #444444;
        font-family: "Courier New", Courier, monospace;
        text-align: center;
      }
      address a:link,
      address a:visited {
        color: #0000ee;
      }
    </style>
  </head>

  <body>
    <h1>Jordon de Hoog</h1>
    <p>
      <i>Software Engineer &middot; Kotlin, Kotlin Multiplatform, Android</i>
    </p>
    <p class="topnav">
      [ <a href="#summary">Summary</a>
      | <a href="#apps">Apps</a>
      | <a href="#libraries">Libraries</a>
      | <a href="#tools">Tools</a>
      | <a href="#talks">Talks</a>
      | <a href="#contact">Contact</a>
      | <a href="/modern">Modern site</a> ]
    </p>

    <div class="status">
      <b>Status:</b> Open to new opportunities. Full-time, contract, or consulting.
      Based in Canada, available remote. The fastest way to reach me is by <a
        href="mailto:jordon.dehoog@gmail.com">email</a
      >.
    </div>

    <h2 id="summary">Summary</h2>
    <p>
      I am a software engineer with deep experience in <b>Kotlin</b>,
      <b>Kotlin Multiplatform</b>, and the <b>Android</b> platform. I build production
      mobile applications and maintain a portfolio of widely-used open source libraries
      that ship inside real products on Android, iOS, desktop, and the JVM.
    </p>
    <p>
      My open source work has earned roughly
      <b>{totalStars.toLocaleString()}</b> GitHub stars across
      <b>{libraries.length}</b> libraries and <b>{tools.length}</b> developer tools.
      I am equally comfortable shipping polished consumer apps, designing reusable
      APIs for other engineers, and writing systems-level tooling in Rust.
    </p>

    <h2 id="apps">Applications</h2>
    <p>
      Cross-platform consumer applications I have designed, built, and shipped:
    </p>
    <table class="projects">
      <tr>
        <th style="width: 180px;">App</th>
        <th>Description</th>
        <th style="width: 110px;">Links</th>
      </tr>
      {
        apps.map((app) => (
          <tr>
            <td>
              <b>{app.name}</b>
              {(app.stargazers_count > 0 || app.html_url) && (
                <>
                  <br />
                  <span class="meta" style="font-size: 11px;">
                    {app.stargazers_count > 0 && <>★ {app.stargazers_count}</>}
                    {app.stargazers_count > 0 && app.html_url && " · "}
                    {app.html_url && <a href={app.html_url}>source</a>}
                  </span>
                </>
              )}
            </td>
            <td class="desc">{app.description.split("\n\n")[0]}</td>
            <td class="meta">
              {app.homepage && (
                <>
                  <a href={app.homepage}>website</a>
                  <br />
                </>
              )}
              {app.links?.playStore && (
                <>
                  <a href={app.links.playStore}>google play</a>
                  <br />
                </>
              )}
              {app.links?.appStore && (
                <a href={app.links.appStore}>app store</a>
              )}
            </td>
          </tr>
        ))
      }
    </table>

    <h2 id="libraries">Open Source Libraries</h2>
    <p>
      Open source Kotlin and Compose Multiplatform libraries, sorted by GitHub
      stars:
    </p>
    <table class="projects">
      <tr>
        <th>Library</th>
        <th>Description</th>
        <th style="text-align: right;">Stars</th>
      </tr>
      {
        sortedLibraries.map((lib) => (
          <tr>
            <td>
              <a href={lib.html_url}>
                <b>{lib.name}</b>
              </a>
              {lib.homepage && (
                <>
                  <br />
                  <span class="meta">
                    <a href={lib.homepage}>docs</a>
                  </span>
                </>
              )}
            </td>
            <td class="desc">{lib.description}</td>
            <td class="stars">{lib.stargazers_count.toLocaleString()}</td>
          </tr>
        ))
      }
    </table>

    <h3 id="tools" class="subsection">Developer Tools</h3>
    <p>Smaller utilities and developer tools I have authored:</p>
    <table class="projects">
      <tr>
        <th>Tool</th>
        <th>Description</th>
        <th style="text-align: right;">Stars</th>
      </tr>
      {
        tools.map((tool) => (
          <tr>
            <td>
              <a href={tool.html_url}>
                <b>{tool.name}</b>
              </a>
              {tool.homepage && (
                <>
                  <br />
                  <span class="meta">
                    <a href={tool.homepage}>site</a>
                  </span>
                </>
              )}
              {tool.language && (
                <>
                  <br />
                  <span class="meta">{tool.language}</span>
                </>
              )}
            </td>
            <td class="desc">{tool.description}</td>
            <td class="stars">{tool.stargazers_count.toLocaleString()}</td>
          </tr>
        ))
      }
    </table>

    <h2 id="talks">Talks &amp; Community</h2>
    <ul>
      <li>
        <b>Media &amp; Camera Experiences</b>, guest on
        <i>Android Build Time</i>. Discussion of Android Media APIs, video
        format handling, and on-device media editing performance.
        <a href="https://www.youtube.com/watch?v=nWXmrY8J_nY">[video]</a>
      </li>
    </ul>

    <h2 id="contact">Contact</h2>
    <dl>
      <dt>Email</dt>
      <dd>
        <a href="mailto:jordon.dehoog@gmail.com">jordon.dehoog@gmail.com</a>
      </dd>
      <dt>GitHub</dt>
      <dd><a href="https://github.com/jordond">github.com/jordond</a></dd>
      <dt>LinkedIn</dt>
      <dd>
        <a href="https://www.linkedin.com/in/jordondehoog/"
          >linkedin.com/in/jordondehoog</a
        >
      </dd>
      <dt>Resume</dt>
      <dd><a href="/resume.pdf">resume.pdf</a></dd>
    </dl>

    <hr />
    <address>
      Jordon de Hoog &middot;
      <a href="/modern">modern version of this site</a>
    </address>
  </body>
</html>
