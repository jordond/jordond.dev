---
import reposData from "../data/repos.json"

const apps = reposData.apps
const tools = reposData.tools
const libraries = reposData.libraries

const sortedLibraries = libraries
  .slice()
  .sort((a, b) => b.stargazers_count - a.stargazers_count)

const totalStars = [...tools, ...libraries].reduce(
  (sum, r) => sum + (r.stargazers_count ?? 0),
  0,
)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Jordon de Hoog : Software Engineer</title>
    <meta
      name="description"
      content="Jordon de Hoog — software engineer specializing in Kotlin, Kotlin Multiplatform, and Android. Open source author and maintainer of widely-used Compose Multiplatform libraries."
    />
    <meta name="author" content="Jordon de Hoog" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <h1>Jordon de Hoog</h1>
    <p class="tagline">Software Engineer &middot; Kotlin / KMP / Android</p>

    <div class="status">
      <b>Status:</b> Open to new opportunities. Full-time, contract, or consulting.
      Based in Canada, available remote. The fastest way to reach me is by <a
        href="mailto:jordon.dehoog@gmail.com">email</a
      >.
    </div>

    <table class="stats">
      <tr>
        <td>
          <span class="num">{totalStars.toLocaleString()}</span>
          <span class="lbl">GitHub Stars</span>
        </td>
        <td>
          <span class="num">{libraries.length}</span>
          <span class="lbl">OSS Libraries</span>
        </td>
        <td>
          <span class="num">{tools.length}</span>
          <span class="lbl">Dev Tools</span>
        </td>
        <td>
          <span class="num">{apps.length}</span>
          <span class="lbl">Apps</span>
        </td>
      </tr>
    </table>

    <p class="topnav">
      <span class="sep">[ </span>
      <a href="#summary">Summary</a>
      <span class="sep"> | </span>
      <a href="#apps">Apps</a>
      <span class="sep"> | </span>
      <a href="#libraries">Libraries</a>
      <span class="sep"> | </span>
      <a href="#tools">Tools</a>
      <span class="sep"> | </span>
      <a href="#talks">Talks</a>
      <span class="sep"> | </span>
      <a href="#contact">Contact</a>
      <span class="sep"> | </span>
      <a href="/modern">Modern site</a>
      <span class="sep"> ]</span>
    </p>

    <h2 id="summary">Summary</h2>
    <p>
      I am a software engineer with deep experience in <b>Kotlin</b>,
      <b>Kotlin Multiplatform</b>, and the <b>Android</b> platform. I ship production
      consumer apps and maintain a portfolio of widely-used open source libraries
      that other engineers depend on in real products.
    </p>
    <p>
      My open source work has earned roughly
      <b>{totalStars.toLocaleString()}</b> GitHub stars across
      <b>{libraries.length}</b> libraries and <b>{tools.length}</b> developer tools.
      I am equally comfortable shipping polished consumer apps and designing reusable
      APIs that other engineers build on.
    </p>

    <h2 id="apps">Applications</h2>
    <p>Apps I have worked on or built and shipped:</p>
    <table class="projects">
      <tr>
        <th style="width: 180px;">App</th>
        <th>Description</th>
        <th style="width: 110px;">Links</th>
      </tr>
      {
        apps.map((app) => (
          <tr>
            <td>
              <b>{app.name}</b>
              {app.role && (
                <>
                  <br />
                  <span class="role">
                    Role: <b>{app.role}</b>
                  </span>
                </>
              )}
              {(app.stargazers_count > 0 || app.html_url) && (
                <>
                  <br />
                  <span class="meta" style="font-size: 11px;">
                    {app.stargazers_count > 0 && <>★ {app.stargazers_count}</>}
                    {app.stargazers_count > 0 && app.html_url && " · "}
                    {app.html_url && <a href={app.html_url}>source</a>}
                  </span>
                </>
              )}
            </td>
            <td class="desc">{app.description.split("\n\n")[0]}</td>
            <td class="meta">
              {app.homepage && (
                <>
                  <a href={app.homepage}>website</a>
                  <br />
                </>
              )}
              {app.links?.playStore && (
                <>
                  <a href={app.links.playStore}>google play</a>
                  <br />
                </>
              )}
              {app.links?.appStore && (
                <a href={app.links.appStore}>app store</a>
              )}
            </td>
          </tr>
        ))
      }
    </table>

    <h2 id="libraries">Open Source Libraries</h2>
    <p>
      Open source Kotlin and Compose Multiplatform libraries, sorted by GitHub
      stars:
    </p>
    <table class="projects">
      <tr>
        <th>Library</th>
        <th>Description</th>
        <th style="text-align: right;">Stars</th>
      </tr>
      {
        sortedLibraries.map((lib) => (
          <tr>
            <td>
              <a href={lib.html_url}>
                <b>{lib.name}</b>
              </a>
              {lib.homepage && (
                <>
                  <br />
                  <span class="meta">
                    <a href={lib.homepage}>docs</a>
                  </span>
                </>
              )}
            </td>
            <td class="desc">{lib.description}</td>
            <td class="stars">{lib.stargazers_count.toLocaleString()}</td>
          </tr>
        ))
      }
    </table>

    <h3 id="tools" class="subsection">Developer Tools</h3>
    <p>Smaller utilities and developer tools I have authored:</p>
    <table class="projects">
      <tr>
        <th>Tool</th>
        <th>Description</th>
        <th style="text-align: right;">Stars</th>
      </tr>
      {
        tools.map((tool) => (
          <tr>
            <td>
              <a href={tool.html_url}>
                <b>{tool.name}</b>
              </a>
              {tool.homepage && (
                <>
                  <br />
                  <span class="meta">
                    <a href={tool.homepage}>site</a>
                  </span>
                </>
              )}
              {tool.language && (
                <>
                  <br />
                  <span class="meta">{tool.language}</span>
                </>
              )}
            </td>
            <td class="desc">{tool.description}</td>
            <td class="stars">{tool.stargazers_count.toLocaleString()}</td>
          </tr>
        ))
      }
    </table>

    <h2 id="talks">Talks &amp; Community</h2>
    <ul>
      <li>
        <b>Media &amp; Camera Experiences</b>, guest on
        <i>Android Build Time</i>. Discussion of Android Media APIs, video
        format handling, and on-device media editing performance.
        <a href="https://www.youtube.com/watch?v=nWXmrY8J_nY">[video]</a>
      </li>
    </ul>

    <h2 id="contact">Contact</h2>
    <div class="contact">
      <div>
        <b>Email</b><br />
        <a href="mailto:jordon.dehoog@gmail.com">jordon.dehoog@gmail.com</a>
      </div>
      <div>
        <b>GitHub</b><br />
        <a href="https://github.com/jordond">github.com/jordond</a>
      </div>
      <div>
        <b>LinkedIn</b><br />
        <a href="https://www.linkedin.com/in/jordondehoog/">
          linkedin.com/in/jordondehoog
        </a>
      </div>
      <div>
        <b>Resume</b><br />
        <a href="/resume.pdf">resume.pdf</a>
      </div>
    </div>

    <hr />
    <address>
      Jordon de Hoog &middot;
      <a href="/modern">modern version of this site</a>
    </address>
  </body>
</html>

<style is:global>
  html {
    background: #008080;
  }
  body {
    font-family: "Times New Roman", Times, serif;
    font-size: 16px;
    line-height: 1.5;
    color: #000000;
    background: #c0c0c0;
    max-width: 760px;
    margin: 16px auto;
    padding: 16px 24px 28px 24px;
    border: 4px ridge #808080;
  }
  a:link {
    color: #0000ee;
    text-decoration: underline;
  }
  a:visited {
    color: #551a8b;
    text-decoration: underline;
  }
  a:active {
    color: #ff0000;
  }
  h1 {
    font-size: 56px;
    font-weight: 900;
    letter-spacing: -1px;
    margin: 0 0 2px 0;
    color: #000080;
    text-shadow:
      3px 3px 0 #c0c0c0,
      4px 4px 0 #808080;
    line-height: 1;
  }
  .tagline {
    font-family: "Courier New", Courier, monospace;
    font-size: 14px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #000000;
    background: #ffff00;
    display: inline-block;
    padding: 4px 10px;
    border: 2px solid #000000;
    margin: 10px 0 4px 0;
  }
  h2 {
    font-size: 20px;
    font-weight: bold;
    background: #000080;
    color: #ffff00;
    padding: 5px 10px;
    border: 2px outset #c0c0c0;
    margin: 26px 0 10px 0;
  }
  h3 {
    font-size: 17px;
    font-weight: bold;
    margin: 14px 0 2px 0;
  }
  h3.subsection {
    font-family: "Courier New", Courier, monospace;
    font-size: 13px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #000000;
    margin: 20px 0 4px 0;
  }
  h3.subsection::before {
    content: "// ";
    color: #808080;
  }
  p {
    margin: 6px 0;
  }
  hr {
    border: 0;
    border-top: 2px groove #808080;
    margin: 18px 0;
  }
  ul {
    margin: 4px 0 8px 0;
    padding-left: 24px;
  }
  ul.bullets {
    list-style: square;
  }
  li {
    margin: 2px 0;
  }
  table.projects {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    background: #d4d0c8;
    border: 3px outset #c0c0c0;
    margin: 8px 0 12px 0;
  }
  table.projects th {
    text-align: left;
    background: #000080;
    color: #ffffff;
    padding: 5px 8px;
    font-family: "Courier New", Courier, monospace;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  table.projects td {
    text-align: left;
    vertical-align: top;
    padding: 6px 8px;
    border-top: 1px solid #808080;
    font-size: 15px;
  }
  table.projects td.stars {
    text-align: right;
    white-space: nowrap;
    font-family: "Courier New", Courier, monospace;
    font-size: 14px;
    color: #b8860b;
    font-weight: bold;
  }
  .meta {
    font-size: 12px;
    color: #444444;
    font-family: "Courier New", Courier, monospace;
  }
  .role {
    font-family: "Courier New", Courier, monospace;
    font-size: 11px;
    color: #444444;
  }
  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 24px;
    margin: 8px 0 12px 0;
  }
  .role b {
    color: #000000;
    font-weight: bold;
  }
  .topnav {
    text-align: center;
    background: #000080;
    color: #ffffff;
    padding: 6px 8px;
    border: 2px outset #c0c0c0;
    font-family: "Courier New", Courier, monospace;
    font-size: 13px;
    margin: 10px 0 14px 0;
  }
  .topnav a:link,
  .topnav a:visited {
    color: #ffff00;
  }
  .status {
    background: #ffffcc;
    border-left: 4px solid #ff8c00;
    border-top: 1px solid #808080;
    border-right: 1px solid #808080;
    border-bottom: 1px solid #808080;
    padding: 10px 14px;
    margin: 14px 0 18px 0;
    font-size: 16px;
  }
  .status b {
    color: #006400;
  }
  table.stats {
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
    background: #d4d0c8;
    border: 3px outset #c0c0c0;
    margin: 14px 0 18px 0;
  }
  table.stats td {
    width: 25%;
    text-align: center;
    padding: 10px 8px;
    border-right: 2px groove #808080;
    vertical-align: middle;
  }
  table.stats td:last-child {
    border-right: 0;
  }
  table.stats .num {
    display: block;
    font-family: "Courier New", Courier, monospace;
    font-size: 28px;
    font-weight: bold;
    color: #000080;
    line-height: 1.1;
  }
  table.stats .lbl {
    display: block;
    font-family: "Courier New", Courier, monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #444444;
    margin-top: 2px;
  }
  .desc {
    color: #000000;
  }
  address {
    font-style: normal;
    font-size: 12px;
    color: #444444;
    font-family: "Courier New", Courier, monospace;
    text-align: center;
  }
  address a:link,
  address a:visited {
    color: #0000ee;
  }

  @media (max-width: 640px) {
    html {
      background: #c0c0c0;
    }
    body {
      margin: 0;
      padding: 14px 12px 24px 12px;
      border-width: 0;
      border-top: 4px ridge #808080;
      border-bottom: 4px ridge #808080;
      font-size: 15px;
    }
    h1 {
      font-size: 38px;
      letter-spacing: -0.5px;
      text-shadow:
        2px 2px 0 #c0c0c0,
        3px 3px 0 #808080;
    }
    h2 {
      font-size: 17px;
      margin: 22px 0 8px 0;
    }
    .tagline {
      font-size: 12px;
      letter-spacing: 1px;
      padding: 3px 8px;
    }
    .status {
      font-size: 14px;
      padding: 8px 10px;
    }
    .topnav {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      padding: 6px;
      font-size: 13px;
    }
    .topnav .sep {
      display: none;
    }
    .topnav a:link,
    .topnav a:visited {
      flex: 1 1 auto;
      min-width: calc(50% - 4px);
      padding: 10px 6px;
      border: 2px outset #5555aa;
      background: #000080;
      color: #ffff00;
      text-align: center;
      text-decoration: none;
    }
    .topnav a:active {
      border-style: inset;
    }
    table.stats td {
      display: inline-block;
      width: 50%;
      box-sizing: border-box;
      padding: 8px 4px;
      border-right: 0;
      border-top: 2px groove #808080;
    }
    table.stats td:nth-child(1),
    table.stats td:nth-child(2) {
      border-top: 0;
    }
    table.stats td:nth-child(odd) {
      border-right: 2px groove #808080;
    }
    table.stats .num {
      font-size: 24px;
    }
    table.projects,
    table.projects tbody,
    table.projects tr,
    table.projects td,
    table.projects th {
      display: block;
      width: 100% !important;
      box-sizing: border-box;
    }
    table.projects tr {
      border-top: 2px groove #808080;
      padding: 4px 0;
    }
    table.projects tr:first-child {
      border-top: 0;
    }
    table.projects th {
      display: none;
    }
    table.projects td {
      padding: 6px 10px;
      border-top: 0;
      font-size: 14px;
    }
    table.projects td.stars {
      text-align: left;
      padding-top: 0;
    }
    table.projects td.stars::before {
      content: "Stars: ";
      color: #444444;
      font-weight: normal;
    }
    .contact {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
